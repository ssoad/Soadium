# Soadium OS Plymouth boot splash
# Deep-space background, centered logo, sodium-flame progress dots.

Window.SetBackgroundTopColor(0.043, 0.063, 0.129);     # 0B1021
Window.SetBackgroundBottomColor(0.024, 0.035, 0.075);  # 060913

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetOpacity(1);

# Sodium-flame progress dots below the logo
num_dots = 5;
dots_y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 20;
for (i = 0; i < num_dots; i++) {
    dot[i].image = Image.Text("●", 0.980, 0.800, 0.082);  # FACC15
    dot[i].sprite = Sprite(dot[i].image);
    dot[i].sprite.SetX(Window.GetWidth() / 2 - (num_dots * 24) / 2 + i * 24);
    dot[i].sprite.SetY(dots_y);
    dot[i].sprite.SetOpacity(0.15);
}

counter = 0;
fun refresh_callback() {
    counter++;
    active = Math.Int(counter / 10) % num_dots;
    for (i = 0; i < num_dots; i++) {
        if (i == active)
            dot[i].sprite.SetOpacity(1);
        else
            dot[i].sprite.SetOpacity(0.15);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Password prompt (disk encryption)
fun display_password_callback(prompt, bullets) {
    prompt_text = "";
    for (i = 0; i < bullets; i++)
        prompt_text += "•";
    q.image = Image.Text(prompt + "  " + prompt_text, 0.886, 0.910, 0.941);
    q.sprite = Sprite(q.image);
    q.sprite.SetX(Window.GetWidth() / 2 - q.image.GetWidth() / 2);
    q.sprite.SetY(dots_y + 50);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    q.sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

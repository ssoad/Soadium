# Soadium OS - Pinned Stable Versions
# Single source of truth for every versioned component.
# Policy: ONLY stable releases (LTS / stable channels / tagged releases).
# Bump these deliberately after testing; never track moving branches.

# Base system (Ubuntu LTS series)
UBUNTU_LTS_SERIES="24.04"
# Fallback point release if the latest cannot be auto-resolved from releases.ubuntu.com
UBUNTU_FALLBACK_POINT_RELEASE="24.04.4"

# Node.js toolchain
NVM_VERSION="v0.40.3"          # nvm tagged stable release
NODE_CHANNEL="--lts"           # always the current Node.js LTS (stable) line

# Fonts
NERD_FONT_VERSION="v3.3.0"     # nerd-fonts tagged stable release
NERD_FONT_NAME="JetBrainsMono"

# Snap channels
VSCODE_SNAP_CHANNEL="stable"

# Apt channels
DOCKER_APT_CHANNEL="stable"    # download.docker.com channel
BRAVE_APT_CHANNEL="stable"
